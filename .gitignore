**/.cursorignore
**/.claudeignore
**/.env
**/*.env
**/env.*
**/*.env.*
**/old/
**/suggestions/
!**/.env.example
**/.claude/
.serena/
**/__pycache__/
**/*.py[cod]

# Python tooling caches + virtualenvs (mirror deepagent-image/.dockerignore)
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Compound Engineering machine-local config
.compound-engineering/*.local.yaml

# Harness-private state (checkpoints + past archive + session.env), mounted out
# of the workspace at /project/state by run-docker (DEEPAGENTS_STATE_DIR).
deepagent-image/project/state/

# Live HITL config (Milestone 3): its presence turns HITL on, so a stray commit
# would silently flip smoke/CI off the MVP path. The tracked template is
# .harness-config.yaml.example; the active file stays local.
deepagent-image/project/.harness-config.yaml

# Persisted unified-config profile (Milestone 5): host-local defaults for every
# knob outside .env/.harness-config.yaml. Tracked template is
# .harness-profile.yaml.example; the active file stays local.
deepagent-image/project/.harness-profile.yaml

# Live NetJail allowlists. These were tracked until `harness config security`
# grew quick-edit loops that rewrite them in place — which made every allowlist
# experiment a dirty tracked file, one `git add -A` away from shipping a local
# grant to everyone. Tracked templates are host-services.txt.example /
# allowed-domains.txt.example; readers fall through to the template when the
# live file is absent, so a fresh clone keeps the shipped defaults with nothing
# to copy, and only a write materializes the local file.
deepagent-image/netjail/host-services.txt
deepagent-image/netjail/allowed-domains.txt

# Host-side run outputs (all gitignored, all under deepagent-image/):
#  - test-artifacts/  : files tests ship out under smoke -KeepArtifacts / KEEP_ARTIFACTS=1
#  - .ephemeral/      : throwaway workspace copies for run-docker -Ephemeral (deleted on close)
#  - workspace-logs/  : post-run workspace snapshots from run-docker -SaveWorkspace
deepagent-image/test-artifacts/
deepagent-image/.ephemeral/
deepagent-image/workspace-logs/

# Locally-created Ollama tags (`ollama create gemma4:harnesstest1`). The registry
# is a shipped table, and a spec for a tag that exists on exactly one machine is
# personal state in it — inert for everyone else, but noise that reads as a
# supported model. Keep the file locally so the tag carries its num_ctx/reasoning
# metadata here; anything that generalizes belongs in the tag's base model TOML
# (gemma4.toml already carries the reasoning measurement).
deepagent-image/project/providers/*/models/*-harnesstest*.toml
